{
  "expo": {
    "name": "Alla Vostra",
    "slug": "alla-vostra-mobile",
    "version": "1.0.0",
    "scheme": "allavostra",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/store/app-icon.png",
    "splash": {
      "image": "./assets/store/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFCF2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.allavostra.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/store/adaptive-foreground.png",
        "backgroundColor": "#FFFCF2"
      },
      "permissions": [
        "VIBRATE"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#f7b967",
      "barStyle": "light-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#f7b967",
      "barStyle": "dark-content",
      "enforceContrast": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#f7b967",
          "borderColor": "#f7b967",
          "barStyle": "dark",
          "position": "relative",
          "behavior": "inset-touch"
        }
      ],
      "./plugins/with-android-material-components-theme",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.allavostra",
          "enableGooglePay": true
        }
      ]
    ]
  }
}
