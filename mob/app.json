{
  "expo": {
    "name": "Alla Vostra",
    "slug": "alla-vostra",
    "version": "1.0.3",
    "scheme": "allavostra",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/store/app-icon.png",
    "splash": {
      "image": "./assets/store/splash-orange-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#f7b967"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.allavostra.app",
      "versionCode": 4,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/store/adaptive-foreground.png",
        "backgroundColor": "#FFFCF2"
      },
      "permissions": [
        "VIBRATE"
      ]
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "enforceContrast": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./plugins/with-android-blank-native-splash",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.allavostra",
          "enableGooglePay": true
        }
      ],
      "./plugins/with-android-material-components-theme"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5c39d44b-1b4e-4852-92ef-472349741e35"
      }
    },
    "owner": "prahlin1s-team"
  }
}
