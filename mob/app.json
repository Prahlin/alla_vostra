{
  "expo": {
    "name": "Alla Vostra",
    "slug": "alla-vostra",
    "version": "1.0.2",
    "scheme": "allavostra",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/store/app-icon.png",
    "splash": {
      "image": "./assets/store/splash-orange-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#f7b967"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.allavostra.app",
      "versionCode": 3,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/store/adaptive-foreground.png",
        "backgroundColor": "#FFFCF2"
      },
      "permissions": [
        "VIBRATE"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#f7b967",
      "barStyle": "light-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#edb061",
      "barStyle": "dark-content",
      "enforceContrast": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#edb061",
          "borderColor": "#edb061",
          "barStyle": "dark",
          "position": "relative",
          "behavior": "inset-touch"
        }
      ],
      "./plugins/with-android-material-components-theme",
      "./plugins/with-android-blank-native-splash",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.allavostra",
          "enableGooglePay": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "backgroundColor": "#edb061",
        "borderColor": "#edb061",
        "barStyle": "dark",
        "position": "relative",
        "behavior": "inset-touch"
      },
      "eas": {
        "projectId": "5c39d44b-1b4e-4852-92ef-472349741e35"
      }
    },
    "owner": "prahlin1s-team"
  }
}
