{
  "cli": {
    "appVersionSource": "local",
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal"
    },
    "playTest": {
      "environment": "preview",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "testflight": {
      "environment": "preview",
      "distribution": "store"
    },
    "production": {
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "testflight": {},
    "production": {}
  }
}
