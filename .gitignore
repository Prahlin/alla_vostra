**/node_modules/

# Expo / React Native local build state
.expo/
.expo-shared/

# Expo-generated native projects
mob/android/
mob/ios/

# Generated tutorial animation diagnostics
mob/assets/tutorial/smiley-got-it-storyboard/smooth/sprite_frame_*.png

# Build outputs
dist/
build/
web-build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# Private launch/tester materials
private/

# Python artifacts (shop.py, test.py scripts)
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# OS/editor noise
.DS_Store
.idea/
.vscode/
